---
import { guidesFor, childGuidesFor } from '../data/apps.mjs';
import { translator, localeBase } from '../data/i18n.mjs';
const { slug } = Astro.props;
const pathname = Astro.url.pathname;
const tr = translator(Astro.locals.t);
const base = localeBase(Astro.locals.starlightRoute);
const href = (page) => `${base}/apps/${slug}/${page}/`;
const current = (page) => (pathname === href(page) ? 'page' : undefined);
---
<div class="wiki-guide-links">
  {guidesFor(slug).map(([guide, label]) => {
    const children = childGuidesFor(slug, guide);
    const link = <a href={href(guide)} aria-current={current(guide)}>{tr(label)}</a>;
    if (!children.length) return link;
    const open = !!current(guide) || children.some(([child]) => current(child));
    return (
      <div class="wiki-guide-parent">
        {link}
        <details class="wiki-guide-group" open={open}>
          <summary aria-label={tr('{label} pages').replace('{label}', tr(label))}><span class="wiki-guide-chevron" aria-hidden="true">⌄</span></summary>
          <div class="wiki-guide-children">
            {children.map(([child, childLabel]) => <a href={href(child)} aria-current={current(child)}>{tr(childLabel)}</a>)}
          </div>
        </details>
      </div>
    );
  })}
</div>
