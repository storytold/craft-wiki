{
  "name": "craft-wiki",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/prepare-cms.mjs && astro build",
    "preview": "astro preview",
    "check:safebrowsing": "node scripts/check-safebrowsing.mjs craft.wiki",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='worker/**' --test-coverage-exclude='**/*.test.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info worker/index.test.mjs scripts/cms-config.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltia/cms": "^0.261.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  }
}
